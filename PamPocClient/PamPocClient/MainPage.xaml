<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:PamPocClient.ViewModels"
             xmlns:models="clr-namespace:PamPocClient.Models"
             x:Class="PamPocClient.MainPage"
             x:DataType="viewmodels:MainViewModel"
             BackgroundColor="#F7F7F8">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Loading overlay -->
        <Grid Grid.RowSpan="2"
              BackgroundColor="#80000000"
              IsVisible="{Binding IsBusy}">
            <VerticalStackLayout VerticalOptions="Center"
                               HorizontalOptions="Center"
                               Spacing="16">
                <ActivityIndicator IsRunning="{Binding IsBusy}"
                                 Color="White"
                                 WidthRequest="40"
                                 HeightRequest="40" />
                <Label Text="{Binding StatusMessage}"
                       TextColor="White"
                       FontSize="16"
                       HorizontalOptions="Center" />
            </VerticalStackLayout>
        </Grid>

        <!-- Main content area -->
        <ScrollView Grid.Row="0" Padding="20">
            <Grid RowSpacing="20" RowDefinitions="Auto,Auto,*">
                <Image Source="intelliabb.png" 
                       Aspect="AspectFit" 
                       HeightRequest="28" />
                
                <!-- Pam logo/title area -->
                <VerticalStackLayout Spacing="10" Grid.Row="1">
                    <Label Text="Hi, I am Pam!"
                           FontSize="36"
                           FontAttributes="Bold"
                           TextColor="#2D3748"
                           HorizontalOptions="Center" />
                    
                    <Label Text="How can I help you today?"
                           FontSize="18"
                           TextColor="#718096"
                           HorizontalOptions="Center" />
                </VerticalStackLayout>

                <!-- Chat messages area -->
                <CollectionView ItemsSource="{Binding Messages}"
                              Margin="0,40,0,0"
                              BackgroundColor="Transparent"
                              Grid.Row="2"
                              VerticalOptions="End">
                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:ChatMessage">
                            <Grid Padding="0,8">
                                <Border BackgroundColor="{Binding IsUser, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#EFEFEF,#ffffff'}"
                                        Stroke="#E2E8F0"
                                        StrokeShape="RoundRectangle 12"
                                        Padding="16"
                                        HorizontalOptions="{Binding IsUser, Converter={StaticResource BoolToLayoutOptionsConverter}, ConverterParameter='End,Fill'}">
                                    <StackLayout Spacing="8">
                                        <Label Text="{Binding Content}"
                                               TextColor="#4A5568"
                                               FontSize="Medium"
                                               LineBreakMode="WordWrap" />
                                        <Label Text="{Binding Timestamp, StringFormat='{0:HH:mm}'}"
                                               TextColor="#4A5568"
                                               FontSize="12"
                                               HorizontalOptions="End" />
                                    </StackLayout>
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>
            </Grid>
        </ScrollView>

        <!-- Input section at bottom -->
        <Border Grid.Row="1"
                BackgroundColor="White"
                Stroke="#E2E8F0"
                Padding="16"
                Shadow="{Shadow Brush=LightGray, Offset='0,-2', Radius=4, Opacity=0.2}">
            
            <Grid VerticalOptions="Center" ColumnDefinitions="*, auto, auto" ColumnSpacing="12">
                
                <!-- Text input -->
                <Entry Text="{Binding MessageText}"
                       Placeholder="Message Pam..."
                       FontSize="16"
                       BackgroundColor="#F7F7F8"
                       TextColor="#2D3748"
                       HorizontalOptions="FillAndExpand"
                       HeightRequest="60"
                       VerticalOptions="Center"
                       ReturnType="Send"
                       ReturnCommand="{Binding SendMessageCommand}" />

                <!-- Microphone button -->
                <Button Grid.Column="1" 
                        Text="{Binding IsRecording, Converter={StaticResource BoolToTextConverter}, ConverterParameter='⏹️,🎙️'}"
                        FontSize="18"
                        BackgroundColor="{Binding IsRecording, Converter={StaticResource BoolToColorConverter}, ConverterParameter='#FF6B6B,#E2E8F0'}"
                        TextColor="#4A5568"
                        WidthRequest="60"
                        HeightRequest="60"
                        CornerRadius="30"
                        BorderWidth="0"
                        Command="{Binding ToggleRecordingCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />

                <!-- Send button -->
                <Button Grid.Column="2" 
                        Text="→"
                        FontSize="18"
                        BackgroundColor="#5A67D8"
                        TextColor="White"
                        WidthRequest="60"
                        HeightRequest="60"
                        CornerRadius="30"
                        BorderWidth="0"
                        Command="{Binding SendMessageCommand}"
                        IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBoolConverter}}" />
            </Grid>
        </Border>
    </Grid>
</ContentPage>